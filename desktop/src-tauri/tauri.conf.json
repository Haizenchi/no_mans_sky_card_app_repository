{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NMS Passport",
  "version": "2.0.1",
  "identifier": "com.haizenchi.nmspassport",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NMS Passport",
        "width": 1500,
        "height": 950,
        "minWidth": 1050,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; media-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Haizenchi",
    "shortDescription": "NMS Passport desktop toolkit for No Man's Sky",
    "longDescription": "Create, save, share and export Traveller, ship, base and discovery cards in a lightweight offline desktop application.",
    "copyright": "Copyright © 2026 Haizenchi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
